# Aura notifications (mako). History lives in the side panel; Do Not Disturb = `makoctl mode -t do-not-disturb`.
font=Inter Display 11
background-color=#15141bf2
text-color=#edecee
border-color=#2e2c3a
border-size=1
border-radius=14
padding=12,14
margin=10
width=360
height=160
max-visible=4
icons=1
max-icon-size=40
default-timeout=6000
layer=overlay
anchor=top-right
outer-margin=34,8,0,0
format=<b>%s</b>\n<span color="#908f98">%b</span>

[app-name="Spotify"]
border-color=#61ffca

[urgency=low]
text-color=#bdbdbd

[urgency=critical]
border-color=#ff6767
default-timeout=0

[mode=do-not-disturb]
invisible=1
