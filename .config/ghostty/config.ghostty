theme = Aura
font-family = BlexMono Nerd Font Mono
font-size = 11
window-padding-x = 12
window-padding-y = 10
cursor-style = bar

# --- iTerm-like look ---
window-theme = ghostty
window-show-tab-bar = auto
window-new-tab-position = end
unfocused-split-opacity = 0.85
split-divider-color = #2e2c3a
window-save-state = always
confirm-close-surface = true
copy-on-select = clipboard

# --- iTerm-like keys (Ctrl where iTerm uses Cmd) ---
# Tabs
keybind = ctrl+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=last_tab

# Splits (iTerm Cmd+D / Cmd+Shift+D)
# splits: Ctrl+Shift+→ right, Ctrl+Shift+↓ down (tabs: Ctrl+Tab / Ctrl+Shift+Tab, Ctrl+Shift+← previous)
keybind = ctrl+shift+arrow_right=new_split:right
keybind = ctrl+shift+arrow_down=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom

# Fullscreen on F11, not Ctrl+Enter
keybind = ctrl+enter=unbind
keybind = f11=toggle_fullscreen

# Misc
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+comma=open_config
keybind = ctrl+v=paste_from_clipboard
