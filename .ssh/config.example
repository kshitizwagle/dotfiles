# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github
    IdentitiesOnly yes
    AddKeysToAgent yes

# envy — LAN
Host envy
    HostName 192.168.x.x
    User <user>
    IdentityFile ~/.ssh/envy
    IdentitiesOnly yes
    AddKeysToAgent yes

# envy — remote via Cloudflare Access (needs cloudflared)
Host envy-cf
    HostName ssh.example.com
    User <user>
    IdentityFile ~/.ssh/envy
    IdentitiesOnly yes
    AddKeysToAgent yes
    ProxyCommand cloudflared access ssh --hostname %h
    # Windows: ProxyCommand cloudflared.exe access ssh --hostname %h
